<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A thread-safe utility for obtaining NuGet's OpenApiClient singleton.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Cloudflare.NuGet.OpenApiClientUtil</AssemblyName>
        <PackageId>Soenneker.Cloudflare.NuGet.OpenApiClientUtil</PackageId>
        <PackageTags>cloudflare nuget openapiclientutil openapi kiota client util singleton cloudflarenugetopenapiclientutil csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.cloudflare.nuget.openapiclientutil</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.cloudflare.nuget.openapiclientutil</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">$(PACKAGE_RELEASE_NOTES)</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Kiota.GenericAuthenticationProvider" Version="4.0.56" />
        <ProjectReference Include="../../../soenneker.cloudflare.nuget.httpclients/src/Soenneker.Cloudflare.NuGet.HttpClients/Soenneker.Cloudflare.NuGet.HttpClients.csproj" Condition="Exists('../../../soenneker.cloudflare.nuget.httpclients/src/Soenneker.Cloudflare.NuGet.HttpClients/Soenneker.Cloudflare.NuGet.HttpClients.csproj')" />
        <PackageReference Include="Soenneker.Cloudflare.NuGet.HttpClients" Version="11.0.0" Condition="!Exists('../../../soenneker.cloudflare.nuget.httpclients/src/Soenneker.Cloudflare.NuGet.HttpClients/Soenneker.Cloudflare.NuGet.HttpClients.csproj')" />
        <ProjectReference Include="../../../soenneker.cloudflare.nuget.openapiclient/src/Soenneker.Cloudflare.NuGet.OpenApiClient/Soenneker.Cloudflare.NuGet.OpenApiClient.csproj" Condition="Exists('../../../soenneker.cloudflare.nuget.openapiclient/src/Soenneker.Cloudflare.NuGet.OpenApiClient/Soenneker.Cloudflare.NuGet.OpenApiClient.csproj')" />
        <PackageReference Include="Soenneker.Cloudflare.NuGet.OpenApiClient" Version="11.0.0" Condition="!Exists('../../../soenneker.cloudflare.nuget.openapiclient/src/Soenneker.Cloudflare.NuGet.OpenApiClient/Soenneker.Cloudflare.NuGet.OpenApiClient.csproj')" />
        <PackageReference Include="Soenneker.Utils.AsyncSingleton" Version="4.0.881" />
    </ItemGroup>
</Project>
